{
  "name": "melk-studio",
  "version": "1.2.0",
  "private": true,
  "scripts": {
    "sync:android": "cap sync android",
    "build:preview": "python3 tools/build-standalone.py",
    "build:android": "npm run sync:android && cd android && bash gradlew assembleDebug",
    "test": "node --test \"tests/*.cjs\"",
    "test:e2e": "python3 tests/e2e/run.py",
    "compare:release": "python3 tools/compare-release.py",
    "test:tools": "python3 -m unittest discover -s tests/tools"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^8.3.0",
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capgo/capacitor-updater": "^8.53.1"
  }
}
